---
import SubpageLayout from '../layouts/SubpageLayout.astro';
---
<SubpageLayout title="Clio -> QuickBooks Class & Location Sync - Gauvreau Accounting" description="Every Clio bill's QuickBooks invoice gets the right Class and Location, so you can report revenue by practice area, office and attorney.">
  <style>
    :root {
      --bg: #0d1117;
      --surface: #161b22;
      --surface-hover: #1c2230;
      --border: #30363d;
      --text-primary: #f0ebe0;
      --text-body: #8b949e;
      --text-muted: #6e7681;
      --accent: #d4a843;
      --success: #3fb950;
      --warn: #f0883e;
      --error: #f85149;
      
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-mono: 'DM Mono', 'SF Mono', monospace;
      
      --dur-instant: 80ms;
      --dur-quick: 180ms;
      --dur-base: 320ms;
      --dur-scene: 600ms;
      --ease-enter: cubic-bezier(0, 0, 0.2, 1);
      --ease-exit: cubic-bezier(0.4, 0, 1, 1);
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      
      --radius-lg: 8px;
    }

    main {
      background-color: var(--bg);
      color: var(--text-body);
      font-family: var(--font-mono);
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }

    #ambient-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    .content-wrapper {
      position: relative;
      z-index: 10;
      max-width: 1000px;
      margin: 0 auto;
      padding: 100px 24px 40px;
    }

    .top-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 60px;
      background: rgba(13, 17, 23, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
    }

    #progress-bar {
      position: fixed;
      top: 0; left: 0;
      height: 1px;
      background: var(--accent);
      z-index: 101;
      width: 0%;
    }

    .nav-link {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
      transition: color var(--dur-quick) var(--ease-enter);
    }
    .nav-link:hover { color: var(--text-primary); }
    .prompt { color: var(--accent); margin-right: 8px; }

    h1, h2, h3, h4 {
      font-weight: 400;
      color: var(--text-primary);
      margin-bottom: 16px;
    }
    h1 {
      font-family: var(--font-serif);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-style: italic;
      line-height: 1.1;
    }
    .section-title {
      font-family: var(--font-serif);
      font-size: clamp(2rem, 4vw, 3rem);
      font-style: italic;
    }
    .section-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-transform: uppercase;
      color: var(--accent);
      letter-spacing: 0.05em;
      margin-bottom: 12px;
      display: block;
    }
    .section-body {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text-body);
      max-width: 600px;
      margin-bottom: 32px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 4px 12px;
      background: rgba(212, 168, 67, 0.1);
      border: 1px solid var(--accent);
      border-radius: 4px;
      color: var(--accent);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 24px;
    }

    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity var(--dur-scene) var(--ease-exit), transform var(--dur-scene) var(--ease-exit);
    }
    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    section { padding: 60px 0; }

    .video-section { padding-top: 0; }
    .video-wrapper {
      background: #000;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05) inset;
      transition: transform var(--dur-scene) var(--ease-spring), border-color var(--dur-base) var(--ease-enter), box-shadow var(--dur-base) var(--ease-enter);
    }
    .video-wrapper:hover {
      border-color: var(--accent);
      box-shadow: 0 32px 100px rgba(212, 168, 67, 0.15), 0 0 0 1px rgba(212, 168, 67, 0.2) inset;
      transform: translateY(-4px);
    }
    @media (prefers-reduced-motion: reduce) {
      .video-wrapper, .video-wrapper:hover { transition: none; transform: none; }
    }
    .video-header {
      height: 38px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      padding: 0 16px;
      position: relative;
      z-index: 2;
    }
    .window-controls { display: flex; gap: 8px; }
    .dot { width: 10px; height: 10px; border-radius: 50%; }
    .dot.close { background: #ff5f56; opacity: 0.8; }
    .dot.min { background: #ffbd2e; opacity: 0.8; }
    .dot.max { background: #27c93f; opacity: 0.8; }
    .window-title {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-muted);
      letter-spacing: 0.5px;
    }
    .video-body {
      position: relative;
      aspect-ratio: 16 / 9;
      width: 100%;
      background: #050505;
    }
    .video-body iframe {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      border: 0;
    }
    .below-fold { content-visibility: auto; contain-intrinsic-size: 600px; }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
      transition: border-color var(--dur-base) var(--ease-enter);
    }
    .card:hover { border-color: var(--accent); }
    .card h3 {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      margin-bottom: 8px;
      color: var(--text-primary);
    }
    .card p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; }

    .flow-steps {
      display: flex; flex-direction: column; gap: 16px;
    }
    .flow-step {
      display: flex; gap: 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
      align-items: flex-start;
    }
    .flow-num {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 1.2rem;
    }
    .flow-step h4 { font-family: var(--font-mono); font-size: 1.1rem; margin-bottom: 4px; }
    .flow-step p { font-size: 0.9rem; color: var(--text-muted); }

    .check-list { list-style: none; padding: 0; }
    .check-list li {
      position: relative;
      padding-left: 24px;
      margin-bottom: 12px;
      color: var(--text-primary);
    }
    .check-list li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .compare-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    @media (max-width: 768px) { .compare-grid { grid-template-columns: 1fr; } }
    .compare-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
    }
    .compare-card.before { border-top: 2px solid var(--error); }
    .compare-card.after { border-top: 2px solid var(--success); }
    .compare-card h3 { font-family: var(--font-mono); font-size: 1.2rem; }
    .compare-card ul { list-style: none; padding: 0; }
    .compare-card li {
      margin-bottom: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
      font-size: 0.9rem;
      color: var(--text-muted);
    }
    .compare-card li:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }

    .faq-item { border-bottom: 1px solid var(--border); }
    .faq-btn {
      width: 100%; background: none; border: none;
      color: var(--text-primary); font-family: var(--font-mono);
      font-size: 1rem; text-align: left; padding: 24px 0;
      cursor: pointer; display: flex; justify-content: space-between; align-items: center;
    }
    .faq-btn:hover { color: var(--accent); }
    .faq-content {
      max-height: 0; overflow: hidden;
      transition: max-height var(--dur-base) var(--ease-spring);
    }
    .faq-content p { padding-bottom: 24px; color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; }

    .cta-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 48px;
      margin-top: 40px;
    }
    .cta-box h2 {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: clamp(2rem, 4vw, 2.5rem);
    }
    .cta-btn {
      display: inline-block; margin-top: 24px; padding: 12px 24px;
      background: transparent; color: var(--accent); border: 1px solid var(--accent);
      text-decoration: none; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em;
      transition: all var(--dur-quick) var(--ease-enter);
    }
    .cta-btn:hover { background: var(--accent); color: var(--bg); }

    .footer { text-align: center; padding: 40px 0; border-top: 1px solid var(--border); margin-top: 80px; }

    .code-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--text-primary);
      overflow-x: auto;
      margin-top: 24px;
    }
    .code-card .key { color: var(--accent); }
    .code-card .note { color: var(--text-muted); }
  </style>

  <main>
    <div id="progress-bar"></div>
    <canvas id="ambient-canvas"></canvas>

    <nav class="top-nav">
      <div class="nav-left">
        <span class="prompt">$</span>
        <img loading="lazy" decoding="async" src="https://gauvreaucpa.ca/hs-fs/hubfs/Mobile%20Logo_-1.png" alt="Gauvreau" style="height:14px;width:auto;display:block;">
      </div>
      <div class="nav-right">
        <a href="/" class="nav-link">&larr; Back to Suite</a>
      </div>
    </nav>

    <div class="content-wrapper">
      <section id="hero" class="reveal">
        <div class="badge">[STATUS: LIVE] &middot; Revenue Reporting</div>
        <h1>Clio &rarr; QuickBooks Class &amp; Location Sync</h1>
        <p class="section-body" style="font-size: 1.2rem; max-width: 800px;">
          Every Clio bill's QuickBooks invoice gets the right Class and Location — so you can report revenue by practice area, office and attorney.
        </p>
      </section>

      <section class="video-section reveal">
        <div class="video-wrapper">
          <div class="video-header">
            <div class="window-controls">
              <span class="dot close"></span>
              <span class="dot min"></span>
              <span class="dot max"></span>
            </div>
            <div class="window-title">tutorial.mp4</div>
          </div>
          <div class="video-body">
            <iframe
              src="https://www.youtube.com/embed/KixRPOICvdU?autoplay=1&mute=1&loop=1&playlist=KixRPOICvdU&rel=0&modestbranding=1&playsinline=1"
              title="Clio to QuickBooks Class &amp; Location Sync Tutorial"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">The Challenge</span>
        <h2 class="section-title reveal">Invoices arrive in QuickBooks untagged</h2>
        <p class="section-body reveal">
          Clio bills reach QuickBooks Online as invoices, but without a Class or Location. Your revenue reports can't tell one practice area, office or attorney from another.
        </p>

        <div class="card-grid">
          <div class="card reveal">
            <h3>No revenue breakdown</h3>
            <p>Without Class and Location on each invoice, QBO can't report revenue by practice area, office or attorney.</p>
          </div>
          <div class="card reveal">
            <h3>Tagging by hand</h3>
            <p>Someone has to open every invoice, look up the matter in Clio, and pick the Class and Location manually.</p>
          </div>
          <div class="card reveal">
            <h3>Inconsistent names</h3>
            <p>Manual tagging drifts — slightly different Class names split one practice area into several lines on the report.</p>
          </div>
          <div class="card reveal">
            <h3>Risky edits</h3>
            <p>Re-opening and re-saving invoices to add tags risks changing lines, amounts, tax or memos by accident.</p>
          </div>
        </div>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Workflow</span>
        <h2 class="section-title reveal">How it works</h2>

        <div class="flow-steps reveal">
          <div class="flow-step">
            <span class="flow-num">01</span>
            <div>
              <h4>A bill changes in Clio</h4>
              <p>When a bill is created or updated, Clio notifies the service straight away.</p>
            </div>
          </div>
          <div class="flow-step">
            <span class="flow-num">02</span>
            <div>
              <h4>The matter is mapped</h4>
              <p>The service reads the bill's matter and works out its Class and Location from your firm's mapping rules.</p>
            </div>
          </div>
          <div class="flow-step">
            <span class="flow-num">03</span>
            <div>
              <h4>The QBO invoice is tagged</h4>
              <p>The invoice with the same number gets the Class on every item line and the Location on the header — nothing else on it changes.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Capabilities</span>
        <h2 class="section-title reveal">Features</h2>
        <div class="card-grid" style="margin-bottom: 32px;">
          <div class="card reveal"><h3>Rules from the matter</h3><p>Map from practice area, responsible or originating attorney, matter or client details, or any custom matter field.</p></div>
          <div class="card reveal"><h3>Fallbacks &amp; name templates</h3><p>If the main field is empty, the next one in your list is tried. Templates like <code>&#123;practice_area&#125; / &#123;value&#125;</code> keep names consistent.</p></div>
          <div class="card reveal"><h3>Creates what's missing</h3><p>If a Class or Location doesn't exist in QuickBooks yet, it's created automatically.</p></div>
          <div class="card reveal"><h3>Never overwrites</h3><p>The invoice is read in full and only the Class and Location are changed. Lines, amounts, tax and memos stay exactly as they were.</p></div>
          <div class="card reveal"><h3>Waits for the invoice</h3><p>If the QBO invoice hasn't appeared yet, the bill is retried — about 10 min, 20 min, then every 30 min — until it does.</p></div>
          <div class="card reveal"><h3>Respects paid &amp; voided</h3><p>Voided invoices are skipped, and firms can choose to leave fully paid invoices untouched.</p></div>
          <div class="card reveal"><h3>Stays under API limits</h3><p>Per-firm pacing and throttle handling keep Clio and QuickBooks from rate-limiting your firm.</p></div>
          <div class="card reveal"><h3>Ops console &amp; alerts</h3><p>Every un-synced bill grouped by cause with one-click retry, plus Slack or Discord alerts and a daily summary.</p></div>
          <div class="card reveal"><h3>Preview before it writes</h3><p>Dry runs show exactly which Class and Location a bill would get, without changing anything in QBO.</p></div>
        </div>

        <h3 class="reveal" style="font-family: var(--font-mono); font-size: 1.1rem; margin-top: 40px; color: var(--accent);">Every invoice. Every line. Tagged.</h3>
        <p class="section-body reveal">Bill changed &rarr; Invoice found &rarr; Matter mapped &rarr; Class &amp; Location applied &rarr; Confirmed in QBO</p>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Mapping</span>
        <h2 class="section-title reveal">Your rules, per firm</h2>
        <p class="section-body reveal">Each firm sets its own mapping in a short setup wizard. Names are cleaned up automatically before they reach QuickBooks.</p>
        <ul class="check-list reveal">
          <li>Primary field — a Clio matter field or custom field (e.g. Department)</li>
          <li>Fallbacks — an ordered list tried when the primary is empty</li>
          <li>Name template — optional, e.g. practice area / value</li>
          <li>Normalization — stray spaces collapsed, QBO-reserved characters replaced</li>
          <li>Auto-create — new Classes and Locations added to QBO as needed</li>
        </ul>
        <pre class="code-card reveal"><span class="note">// example firm mapping</span>
&#123;
  <span class="key">"clio_class_field"</span>: "Department",
  <span class="key">"class_mapping_fallbacks"</span>: ["@practice_area", "@responsible_attorney"],
  <span class="key">"location_mapping_fallbacks"</span>: ["@originating_attorney"],
  <span class="key">"class_name_template"</span>: "&#123;practice_area&#125; / &#123;value&#125;"
&#125;</pre>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Comparison</span>
        <h2 class="section-title reveal">Before / After</h2>

        <div class="compare-grid">
          <div class="compare-card before reveal">
            <h3 style="color: var(--error); margin-bottom: 16px;">Manual</h3>
            <ul>
              <li>Invoice arrives in QBO untagged</li>
              <li>Look up the matter in Clio</li>
              <li>Decide the Class and Location</li>
              <li>Edit and re-save the invoice</li>
              <li>Hope nothing else changed</li>
              <li>Fix inconsistent names at month-end</li>
            </ul>
          </div>
          <div class="compare-card after reveal">
            <h3 style="color: var(--success); margin-bottom: 16px;">Automated</h3>
            <ul>
              <li>Bill changes in Clio</li>
              <li>Matter mapped by your rules</li>
              <li>Class &amp; Location applied to the invoice</li>
              <li>Everything else left untouched</li>
              <li style="color: var(--success);">Revenue reports by practice area, office &amp; attorney</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Value</span>
        <h2 class="section-title reveal">Benefits</h2>
        <div class="card-grid">
          <div class="card reveal"><h3>Revenue by practice area</h3><p>See which practice areas, offices and attorneys bring in revenue, straight from QBO reports.</p></div>
          <div class="card reveal"><h3>No more tagging by hand</h3><p>Your team stops opening invoices one by one to set Class and Location.</p></div>
          <div class="card reveal"><h3>Consistent names</h3><p>The same rules every time mean one Class per practice area, not five spellings of it.</p></div>
          <div class="card reveal"><h3>Invoices stay intact</h3><p>Only the tags change — totals, tax and lines are never rewritten.</p></div>
          <div class="card reveal"><h3>Nothing slips through</h3><p>Every bill that isn't tagged yet shows up in the console with its cause and a fix.</p></div>
          <div class="card reveal"><h3>Zero change in Clio</h3><p>Your team keeps billing in Clio exactly as they always have.</p></div>
        </div>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Knowledge Base</span>
        <h2 class="section-title reveal">FAQ</h2>

        <div class="faq-container reveal">
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">Will it change anything else on our invoices? <span>+</span></button>
            <div class="faq-content"><p>No. The invoice is read in full and written back with only the Class (on item lines) and Location (on the header) changed. Lines, amounts, tax and memos are preserved.</p></div>
          </div>
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">What if the invoice isn't in QuickBooks yet? <span>+</span></button>
            <div class="faq-content"><p>The bill waits and retries automatically — about 10 minutes, then 20, then every 30 minutes — until the matching invoice appears. It never gives up on its own.</p></div>
          </div>
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">What if a matter doesn't match any rule? <span>+</span></button>
            <div class="faq-content"><p>The bill is flagged as "no mapping" in the console with the reason. Adjust the mapping, then retry it with one click.</p></div>
          </div>
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">Does it touch paid or voided invoices? <span>+</span></button>
            <div class="faq-content"><p>Voided invoices are always skipped. Fully paid invoices can be left untouched too — it's a per-firm setting.</p></div>
          </div>
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">Our invoice numbers have a prefix in QBO. Will it still match? <span>+</span></button>
            <div class="faq-content"><p>Yes. If QBO invoice numbers are the Clio bill number with a prefix (e.g. INV-1234), the prefix is applied when matching. The console can even detect it for you.</p></div>
          </div>
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">Is our data secure? <span>+</span></button>
            <div class="faq-content"><p>Yes. Connection tokens are encrypted at rest, incoming webhooks are signature-verified, and each firm's configuration and history are kept separate.</p></div>
          </div>
        </div>
      </section>

      <section class="below-fold">
        <div class="cta-box reveal">
          <span class="prompt">$</span>
          <h2>Know where your revenue comes from.</h2>
          <p style="margin: 16px 0; color: var(--text-primary); font-size: 1.2rem;">Bill in Clio. Report in QuickBooks.</p>
          <a href="mailto:info@gauvreaucpa.ca" class="cta-btn">Initialize Service</a>
        </div>
      </section>

      <footer class="footer">
        <a href="/" class="nav-link">&larr; Back to Suite</a>
      </footer>
    </div>
  </main>

  <script is:inline>
    // Scroll progress
    const progress = document.getElementById('progress-bar');
    window.addEventListener('scroll', () => {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      if (h > 0) progress.style.width = (window.scrollY / h * 100) + '%';
    }, { passive: true });

    // Intersection Observer for reveals
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-transitioning');
          requestAnimationFrame(() => {
            entry.target.classList.add('is-visible');
          });
          
          entry.target.addEventListener('transitionend', function handler(e) {
            if (e.propertyName === 'transform') {
              entry.target.classList.remove('is-transitioning');
              entry.target.removeEventListener('transitionend', handler);
            }
          });
          
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // FAQ Accordion
    document.querySelectorAll('.faq-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', !expanded);
        btn.querySelector('span').textContent = expanded ? '+' : '−';
        
        const content = btn.nextElementSibling;
        if (!expanded) {
          content.style.maxHeight = content.scrollHeight + 'px';
        } else {
          content.style.maxHeight = '0px';
        }
      });
    });

    // Ambient Canvas
    (() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const canvas = document.getElementById('ambient-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d', { alpha: true });
      const LINE_SPACING = 56;
      let w = 0, h = 0, dpr = 1, offset = 0, scrollVel = 0, lastY = window.scrollY;
      let rafId, isHidden = false;
      
      function resize() {
        dpr = Math.min(devicePixelRatio, 2);
        w = window.innerWidth; h = window.innerHeight;
        canvas.width = w * dpr; canvas.height = h * dpr;
        canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      
      let rTimer;
      window.addEventListener('resize', () => { clearTimeout(rTimer); rTimer = setTimeout(resize, 100); }, { passive: true });
      resize();
      
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        scrollVel = Math.min(Math.abs(y - lastY), 20);
        lastY = y;
        setTimeout(() => { scrollVel = Math.max(0, scrollVel - 2); }, 80);
      }, { passive: true });
      
      function draw() {
        if (isHidden) return;
        ctx.clearRect(0, 0, w, h);
        const speed = 0.3 + scrollVel * 0.004;
        offset = (offset + speed) % LINE_SPACING;
        const count = Math.ceil(h / LINE_SPACING) + 2;
        ctx.beginPath();
        ctx.strokeStyle = 'rgba(212, 168, 67, 0.04)';
        ctx.lineWidth = 1;
        for (let i = 0; i < count; i++) {
          const y = Math.round(i * LINE_SPACING - offset);
          ctx.moveTo(0, y); ctx.lineTo(w, y);
        }
        ctx.stroke();
        rafId = requestAnimationFrame(draw);
      }
      
      document.addEventListener('visibilitychange', () => {
        isHidden = document.hidden;
        if (!isHidden) { offset = 0; draw(); } else cancelAnimationFrame(rafId);
      });
      draw();
    })();
  </script>
</SubpageLayout>
