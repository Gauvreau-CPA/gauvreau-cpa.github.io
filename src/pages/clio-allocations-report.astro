---
import SubpageLayout from '../layouts/SubpageLayout.astro';
---
<SubpageLayout title="Clio Allocations Report -- Gauvreau Accounting" description="Month-end AR, WIP, Billed, Receipts, Area of Law and Trust reports from Clio Manage, with each payment credited to the timekeepers who earned it.">
<style>
  :root {
    --bg: #0d1117;
    --surface: #161b22;
    --surface-hover: #1c2230;  
    --border: #30363d;
    --text-primary: #f0ebe0;
    --text-body: #8b949e;
    --text-muted: #6e7681;
    --accent: #d4a843;
    --success: #3fb950;
    --warn: #f0883e;
    --error: #f85149;
    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-mono: 'DM Mono', 'SF Mono', monospace;
    --dur-instant: 80ms;
    --dur-quick: 180ms;
    --dur-base: 320ms;
    --dur-scene: 600ms;
    --ease-enter: cubic-bezier(0, 0, 0.2, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  main {
    background: var(--bg);
    color: var(--text-body);
    font-family: var(--font-mono);
    min-height: 100vh;
    padding-bottom: 80px;
    position: relative;
    overflow-x: hidden;
  }
  
  canvas#ambient-canvas {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 0;
  }
  
  .content-wrapper {
    position: relative;
    z-index: 10;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
  }
  
  .nav-bar {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 60px;
    background: rgba(13, 17, 23, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
  }
  
  .nav-left { display: flex; align-items: center; gap: 12px; }
  .prompt { color: var(--accent); font-family: var(--font-mono); font-weight: bold; }
  .logo { height: 16px; width: auto; opacity: 0.9; }
  .back-link {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 14px;
    transition: color var(--dur-quick) var(--ease-enter);
  }
  .back-link:hover { color: var(--accent); }
  
  #progress-bar {
    position: absolute;
    bottom: -1px; left: 0;
    height: 1px;
    background: var(--accent);
    width: 0%;
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity var(--dur-scene) var(--ease-enter), transform var(--dur-scene) var(--ease-enter);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  section { margin-top: 120px; content-visibility: auto; }
  
  .hero { margin-top: 160px; text-align: left; }
  .badge {
    display: inline-block;
    padding: 4px 8px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 12px;
    text-transform: uppercase;
    margin-bottom: 24px;
    border-radius: 4px;
  }
  h1 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: 4rem;
    color: var(--text-primary);
    line-height: 1.1;
    margin-bottom: 24px;
  }
  .tagline { font-size: 1.2rem; max-width: 600px; line-height: 1.6; }
  
  .eyebrow {
    color: var(--accent);
    text-transform: uppercase;
    font-size: 14px;
    margin-bottom: 12px;
    letter-spacing: 1px;
  }
  .section-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2.5rem;
    color: var(--text-primary);
    margin-bottom: 24px;
  }
  
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
    transition: border-color var(--dur-base) var(--ease-enter);
  }
  .card:hover { border-color: var(--accent); }
  .card h3 { color: var(--text-primary); margin-bottom: 12px; font-size: 1.2rem; }
  
  .step-flow { display: flex; flex-direction: column; gap: 16px; font-family: var(--font-mono); }
  .step { display: flex; align-items: flex-start; gap: 16px; }
  .step-num { color: var(--accent); font-weight: bold; }
  .step-arrow { color: var(--border); margin-left: 8px; }
  
  .before-after { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .ba-col {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 32px;
  }
  .ba-col.before { border-left: 4px solid var(--error); }
  .ba-col.after { border-left: 4px solid var(--success); }
  .ba-col h3 { color: var(--text-primary); margin-bottom: 16px; }
  
  details {
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
    font-family: var(--font-mono);
  }
  summary {
    color: var(--text-primary);
    cursor: pointer;
    font-size: 1.1rem;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  details p { margin-top: 12px; color: var(--text-muted); }
  
  .cta-section { text-align: center; margin-top: 160px; padding: 80px 0; border-top: 1px solid var(--border); }
  .terminal {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 16px 24px;
    border-radius: 8px;
    display: inline-block;
    color: var(--text-primary);
    margin-bottom: 32px;
    font-family: var(--font-mono);
  }
  .cta-section h2 {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 3rem;
    color: var(--text-primary);
    margin-bottom: 32px;
  }
  .btn {
    background: var(--accent);
    color: var(--bg);
    padding: 16px 32px;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
    display: inline-block;
    transition: opacity var(--dur-quick) var(--ease-enter);
  }
  .btn:hover { opacity: 0.9; }
  
  footer {
    text-align: center;
    padding: 40px 0;
    border-top: 1px solid var(--border);
    margin-top: 80px;
  }
  /* Allocation calculator */
  .calc {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 32px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .calc h3 { color: var(--text-primary); margin-bottom: 16px; font-size: 1.1rem; }
  .calc-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .calc-row label { font-size: 14px; color: var(--text-body); }
  .calc input[type="number"] {
    width: 130px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 14px;
    padding: 8px 10px;
    text-align: right;
  }
  .calc input[type="number"]:focus-visible,
  .calc input[type="radio"]:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .calc fieldset { border: 0; margin: 16px 0 0; padding: 0; }
  .calc legend { font-size: 14px; color: var(--text-primary); margin-bottom: 8px; }
  .calc .radio { display: flex; gap: 8px; align-items: center; font-size: 14px; margin-bottom: 6px; cursor: pointer; }
  .calc-hint { font-size: 12px; color: var(--text-muted); margin-top: 4px; line-height: 1.5; }
  .calc-out table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .calc-out th, .calc-out td { padding: 8px 4px; border-bottom: 1px solid var(--border); text-align: right; }
  .calc-out th:first-child, .calc-out td:first-child { text-align: left; }
  .calc-out th { color: var(--text-muted); font-weight: normal; font-size: 12px; text-transform: uppercase; }
  .calc-out td { color: var(--text-primary); }
  .calc-out tr.total td { font-weight: bold; color: var(--accent); border-bottom: 0; }
  .calc-steps { margin-top: 20px; font-size: 13px; line-height: 1.8; color: var(--text-body); }
  .calc-steps b { color: var(--text-primary); font-weight: normal; }
  .calc-error { color: var(--error); font-size: 13px; margin-top: 12px; min-height: 1em; }

  .report-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .report-list .card p { font-size: 14px; line-height: 1.6; }
  .report-list .who { display: block; margin-top: 10px; font-size: 12px; color: var(--accent); }

  @media (max-width: 760px) {
    h1 { font-size: 2.6rem; }
    .calc { grid-template-columns: 1fr; padding: 20px; }
    .before-after { grid-template-columns: 1fr; }
    .calc input[type="number"] { width: 110px; }
  }
</style>
<main>
  <canvas id="ambient-canvas"></canvas>

  <div class="nav-bar">
    <div class="nav-left">
      <span class="prompt">$</span>
      <img src="https://gauvreaucpa.ca/hs-fs/hubfs/Mobile%20Logo_-1.png" alt="Gauvreau" class="logo" />
    </div>
    <a href="../" class="back-link">← Suite</a>
    <div id="progress-bar"></div>
  </div>

  <div class="content-wrapper">
    <div class="hero">
      <div class="badge reveal">[MONTH-END]</div>
      <h1 tabindex="-1" class="reveal">Clio Allocations Report</h1>
      <p class="tagline reveal">Month-end firm reports straight from Clio, and who actually brought in each dollar collected.</p>
    </div>

    <section>
      <div class="eyebrow reveal">The Problem</div>
      <h2 class="section-title reveal">Clio pays bills, not people</h2>
      <p class="reveal">A payment in Clio lands on a bill. That bill usually carries time from several lawyers plus costs and tax, so Clio can't tell you whose work the money paid for. Month-end reports mean a stack of exports and an afternoon in Excel.</p>
    </section>

    <section>
      <div class="eyebrow reveal">How It Works</div>
      <h2 class="section-title reveal">Pull, pick a period, export</h2>
      <div class="step-flow reveal">
        <div class="step">
          <span class="step-num">1.</span>
          <div>Sign in to Clio once and click Pull from Clio. The app only reads. It never changes anything in Clio.</div>
        </div>
        <div class="step-arrow">→</div>
        <div class="step">
          <span class="step-num">2.</span>
          <div>Pick a month, quarter, year to date or any date range. Reports rerun in about a second.</div>
        </div>
        <div class="step-arrow">→</div>
        <div class="step">
          <span class="step-num">3.</span>
          <div>Each payment is split among the timekeepers whose time was on that bill.</div>
        </div>
        <div class="step-arrow">→</div>
        <div class="step">
          <span class="step-num">4.</span>
          <div>Export one Excel workbook for the firm, or one per lawyer.</div>
        </div>
      </div>
    </section>

    <section>
      <div class="eyebrow reveal">Try It</div>
      <h2 class="section-title reveal">Split one payment yourself</h2>
      <p class="reveal" style="margin-bottom:24px;">Type in a bill and the payment received on it. The calculator below runs the same split the app runs on every paid bill. Nothing here leaves your browser.</p>
      <div class="calc reveal" id="alloc-calc">
        <div>
          <h3>The bill</h3>
          <div class="calc-row"><label for="tk-a">Partner A, time</label><input id="tk-a" type="number" min="0" step="0.01" value="3000" inputmode="decimal" /></div>
          <div class="calc-row"><label for="tk-b">Associate B, time</label><input id="tk-b" type="number" min="0" step="0.01" value="1500" inputmode="decimal" /></div>
          <div class="calc-row"><label for="tk-c">Clerk C, time</label><input id="tk-c" type="number" min="0" step="0.01" value="500" inputmode="decimal" /></div>
          <div class="calc-row"><label for="costs">Costs and disbursements</label><input id="costs" type="number" min="0" step="0.01" value="400" inputmode="decimal" /></div>
          <div class="calc-row"><label for="tax">Sales tax rate (%)</label><input id="tax" type="number" min="0" max="100" step="0.01" value="13" inputmode="decimal" /></div>
          <div class="calc-row"><label for="paid">Payment received</label><input id="paid" type="number" min="0" step="0.01" value="3051" inputmode="decimal" /></div>
          <fieldset>
            <legend>Credit basis</legend>
            <label class="radio"><input type="radio" name="basis" value="fee" checked /><span>Fee portion only (default)</span></label>
            <label class="radio"><input type="radio" name="basis" value="gross" /><span>Gross, the whole payment</span></label>
            <p class="calc-hint">Fee portion leaves costs and tax uncredited. Gross spreads every dollar by time share, so it all lands on someone.</p>
          </fieldset>
        </div>
        <div class="calc-out" aria-live="polite">
          <h3>Credited to each timekeeper</h3>
          <table>
            <thead><tr><th scope="col">Timekeeper</th><th scope="col">Share</th><th scope="col">Credited</th></tr></thead>
            <tbody id="calc-body"></tbody>
          </table>
          <div class="calc-steps" id="calc-steps"></div>
          <div class="calc-error" id="calc-error"></div>
        </div>
      </div>
    </section>

    <section>
      <div class="eyebrow reveal">Reports</div>
      <h2 class="section-title reveal">What lands in the workbook</h2>
      <div class="report-list">
        <div class="card reveal">
          <h3>AR</h3>
          <p>What clients owed at the end of your period, aged Current, 1-30, 31-60, 61-90 and 91+. A bill paid on 3 August still shows as owing in July.</p>
          <span class="who">By responsible lawyer</span>
        </div>
        <div class="card reveal">
          <h3>WIP</h3>
          <p>Work recorded by the end of the period that wasn't billed yet. July work billed in August counts as July WIP.</p>
          <span class="who">By responsible lawyer</span>
        </div>
        <div class="card reveal">
          <h3>Billed</h3>
          <p>Hours and fees on bills issued in the period, with a column for each month.</p>
          <span class="who">By who recorded the time</span>
        </div>
        <div class="card reveal">
          <h3>Receipts</h3>
          <p>The fee share of each payment received in the period, by month, with the date received on every invoice.</p>
          <span class="who">By who recorded the time</span>
        </div>
        <div class="card reveal">
          <h3>Area of Law</h3>
          <p>Fees and disbursements by practice area for the period and the year to date, against the same dates last year.</p>
          <span class="who">By practice area</span>
        </div>
        <div class="card reveal">
          <h3>Trust</h3>
          <p>Each matter's trust balance and the date its trust money last moved, so dormant balances stand out.</p>
          <span class="who">By lawyer and by bank account</span>
        </div>
      </div>
    </section>

    <section>
      <div class="eyebrow reveal">Comparison</div>
      <h2 class="section-title reveal">Before and after</h2>
      <div class="before-after">
        <div class="ba-col before reveal">
          <h3>Spreadsheets</h3>
          <p>Run five Clio exports, paste them together, rebuild last month's AR by hand because Clio only knows today's balance, and guess at who earned the receipts.</p>
        </div>
        <div class="ba-col after reveal">
          <h3>This app</h3>
          <p>One pull, then any period you like. AR and WIP are rebuilt as they stood on the last day of the period. Every report ends in a Grand Total you can double-click into.</p>
        </div>
      </div>
    </section>

    <section>
      <div class="eyebrow reveal">FAQ</div>
      <h2 class="section-title reveal">Common questions</h2>
      <details class="reveal">
        <summary>Does it change anything in Clio?</summary>
        <p>No. It reads billing, payment, matter, user and trust data and writes nothing back.</p>
      </details>
      <details class="reveal">
        <summary>What happens to a bill with costs but no time?</summary>
        <p>There's nobody to credit, so it's listed on its own Unattributable tab. You can see exactly what's left out.</p>
      </details>
      <details class="reveal">
        <summary>Do credit memos count as money received?</summary>
        <p>Not by default, which matches the firm's receipts. Tick "Count credit memos as payment" if you want them in.</p>
      </details>
      <details class="reveal">
        <summary>Can each lawyer get only their own numbers?</summary>
        <p>Yes. "Export per attorney…" saves one workbook per lawyer with their own AR, WIP, Billed, Receipts and Trust.</p>
      </details>
      <details class="reveal">
        <summary>Why is the trust balance dated the day I pulled?</summary>
        <p>Clio keeps no history for trust balances, so the app can only show them as they were when you pulled.</p>
      </details>
      <details class="reveal">
        <summary>What do I need to run it?</summary>
        <p>Windows 10 or 11, internet access, and a Clio Manage login that can see billing, matters and trust accounts.</p>
      </details>
    </section>

    <div class="cta-section reveal">
      <div class="terminal">$ ClioTimekeeperPayments.exe pull --period 2026-10</div>
      <h2>Month-end in one click.</h2>
      <a href="mailto:contact@gauvreaucpa.ca" class="btn">Contact Gauvreau</a>
    </div>

    <footer>
      <a href="../" class="back-link">← Back to Suite</a>
    </footer>
  </div>
</main>
<script is:inline>
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.reveal').forEach(el => el.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    }

    const progress = document.getElementById('progress-bar');
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const h = document.documentElement.scrollHeight - window.innerHeight;
          if (h > 0) {
            progress.style.width = (window.scrollY / h * 100) + '%';
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  })();

  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const canvas = document.getElementById('ambient-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: true });
    const LINE_SPACING = 56;
    let w = 0, h = 0, dpr = 1, offset = 0, scrollVel = 0, lastY = window.scrollY;
    let rafId, isHidden = false;
    function resize() {
      dpr = Math.min(devicePixelRatio, 2);
      w = window.innerWidth; h = window.innerHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    let rTimer;
    window.addEventListener('resize', () => { clearTimeout(rTimer); rTimer = setTimeout(resize, 100); }, { passive: true });
    resize();
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      scrollVel = Math.min(Math.abs(y - lastY), 20);
      lastY = y;
      setTimeout(() => { scrollVel = Math.max(0, scrollVel - 2); }, 80);
    }, { passive: true });
    function draw() {
      if (isHidden) return;
      ctx.clearRect(0, 0, w, h);
      const speed = 0.3 + scrollVel * 0.004;
      offset = (offset + speed) % LINE_SPACING;
      const count = Math.ceil(h / LINE_SPACING) + 2;
      ctx.beginPath();
      ctx.strokeStyle = 'rgba(212, 168, 67, 0.04)';
      ctx.lineWidth = 1;
      for (let i = 0; i < count; i++) {
        const y = Math.round(i * LINE_SPACING - offset);
        ctx.moveTo(0, y); ctx.lineTo(w, y);
      }
      ctx.stroke();
      rafId = requestAnimationFrame(draw);
    }
    document.addEventListener('visibilitychange', () => {
      isHidden = document.hidden;
      if (!isHidden) { offset = 0; draw(); } else cancelAnimationFrame(rafId);
    });
    draw();
  })();
</script>

<script is:inline>
  // Payment allocation calculator. Mirrors the method in the
  // Clio-UTIL-allocations-report repo (docs/technical.md, "Method").
  (() => {
    const root = document.getElementById('alloc-calc');
    if (!root) return;
    const $ = (id) => document.getElementById(id);
    const money = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });
    const pct = (x) => (x * 100).toFixed(1) + '%';
    const num = (id) => {
      const v = parseFloat($(id).value);
      return Number.isFinite(v) && v > 0 ? v : 0;
    };
    const people = [
      { id: 'tk-a', name: 'Partner A' },
      { id: 'tk-b', name: 'Associate B' },
      { id: 'tk-c', name: 'Clerk C' },
    ];

    function render() {
      const fees = people.map((p) => num(p.id));
      const feeTotal = fees.reduce((a, b) => a + b, 0);
      const costs = num('costs');
      const rate = Math.min(num('tax'), 100) / 100;
      const paid = num('paid');
      const gross = root.querySelector('input[name="basis"]:checked').value === 'gross';

      const preTax = feeTotal + costs;
      const tax = preTax * rate;
      const billTotal = preTax + tax;
      const err = $('calc-error');
      const body = $('calc-body');
      const steps = $('calc-steps');

      if (feeTotal === 0) {
        body.innerHTML = '';
        steps.innerHTML = '';
        err.textContent = 'No time on this bill, so nobody can be credited. The app lists bills like this on its Unattributable tab.';
        return;
      }
      err.textContent = paid > billTotal + 0.005
        ? 'The payment is more than the bill total. The split still runs, but check the numbers.'
        : '';

      // Step 1: take the tax out. Step 2: keep the fee share only.
      const net = billTotal > 0 ? paid * (billTotal - tax) / billTotal : 0;
      const feePay = preTax > 0 ? net * feeTotal / preTax : 0;
      const pool = gross ? paid : feePay;

      let rows = '';
      fees.forEach((f, i) => {
        const share = f / feeTotal;
        rows += '<tr><td>' + people[i].name + '</td><td>' + pct(share) + '</td><td>' + money.format(share * pool) + '</td></tr>';
      });
      rows += '<tr class="total"><td>Grand Total</td><td>100%</td><td>' + money.format(pool) + '</td></tr>';
      body.innerHTML = rows;

      steps.innerHTML = gross
        ? 'Bill total <b>' + money.format(billTotal) + '</b>. Gross basis spreads the whole <b>' + money.format(paid) + '</b> by time share.'
        : 'Bill total <b>' + money.format(billTotal) + '</b>, of which tax <b>' + money.format(tax) + '</b>.<br>' +
          'Payment less tax: <b>' + money.format(net) + '</b>.<br>' +
          'Fee share of that (fees ÷ fees + costs): <b>' + money.format(feePay) + '</b>.<br>' +
          'Left uncredited for costs and tax: <b>' + money.format(paid - feePay) + '</b>.';
    }

    root.addEventListener('input', render);
    root.addEventListener('change', render);
    render();
  })();
</script>
</SubpageLayout>
