---
import SubpageLayout from '../layouts/SubpageLayout.astro';
---
<SubpageLayout title="Client File Intake - A ShareFile Alternative - Gauvreau Accounting" description="A no-login upload page that sends client files straight into your firm's OneDrive, organized by team and date.">
  <style>
    :root {
      --bg: #0d1117;
      --surface: #161b22;
      --surface-hover: #1c2230;
      --border: #30363d;
      --text-primary: #f0ebe0;
      --text-body: #8b949e;
      --text-muted: #6e7681;
      --accent: #d4a843;
      --success: #3fb950;
      --warn: #f0883e;
      --error: #f85149;
      
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-mono: 'DM Mono', 'SF Mono', monospace;
      
      --dur-instant: 80ms;
      --dur-quick: 180ms;
      --dur-base: 320ms;
      --dur-scene: 600ms;
      --ease-enter: cubic-bezier(0, 0, 0.2, 1);
      --ease-exit: cubic-bezier(0.4, 0, 1, 1);
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      
      --radius-lg: 8px;
    }

    main {
      background-color: var(--bg);
      color: var(--text-body);
      font-family: var(--font-mono);
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }

    #ambient-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    .content-wrapper {
      position: relative;
      z-index: 10;
      max-width: 1000px;
      margin: 0 auto;
      padding: 100px 24px 40px;
    }

    .top-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 60px;
      background: rgba(13, 17, 23, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
    }

    #progress-bar {
      position: fixed;
      top: 0; left: 0;
      height: 1px;
      background: var(--accent);
      z-index: 101;
      width: 0%;
    }

    .nav-link {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
      transition: color var(--dur-quick) var(--ease-enter);
    }
    .nav-link:hover { color: var(--text-primary); }
    .prompt { color: var(--accent); margin-right: 8px; }

    h1, h2, h3, h4 {
      font-weight: 400;
      color: var(--text-primary);
      margin-bottom: 16px;
    }
    h1 {
      font-family: var(--font-serif);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-style: italic;
      line-height: 1.1;
    }
    .section-title {
      font-family: var(--font-serif);
      font-size: clamp(2rem, 4vw, 3rem);
      font-style: italic;
    }
    .section-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-transform: uppercase;
      color: var(--accent);
      letter-spacing: 0.05em;
      margin-bottom: 12px;
      display: block;
    }
    .section-body {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text-body);
      max-width: 600px;
      margin-bottom: 32px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 4px 12px;
      background: rgba(212, 168, 67, 0.1);
      border: 1px solid var(--accent);
      border-radius: 4px;
      color: var(--accent);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 24px;
    }

    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity var(--dur-scene) var(--ease-exit), transform var(--dur-scene) var(--ease-exit);
    }
    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    section { padding: 60px 0; }
    .below-fold { content-visibility: auto; contain-intrinsic-size: 600px; }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
      transition: border-color var(--dur-base) var(--ease-enter);
    }
    .card:hover { border-color: var(--accent); }
    .card h3 {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      margin-bottom: 8px;
      color: var(--text-primary);
    }
    .card p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; }

    .flow-steps {
      display: flex; flex-direction: column; gap: 16px;
    }
    .flow-step {
      display: flex; gap: 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
      align-items: flex-start;
    }
    .flow-num {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 1.2rem;
    }
    .flow-step h4 { font-family: var(--font-mono); font-size: 1.1rem; margin-bottom: 4px; }
    .flow-step p { font-size: 0.9rem; color: var(--text-muted); }

    .check-list { list-style: none; padding: 0; }
    .check-list li {
      position: relative;
      padding-left: 24px;
      margin-bottom: 12px;
      color: var(--text-primary);
    }
    .check-list li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .compare-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    @media (max-width: 768px) { .compare-grid { grid-template-columns: 1fr; } }
    .compare-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
    }
    .compare-card.before { border-top: 2px solid var(--error); }
    .compare-card.after { border-top: 2px solid var(--success); }
    .compare-card h3 { font-family: var(--font-mono); font-size: 1.2rem; }
    .compare-card ul { list-style: none; padding: 0; }
    .compare-card li {
      margin-bottom: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
      font-size: 0.9rem;
      color: var(--text-muted);
    }
    .compare-card li:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }

    .faq-item { border-bottom: 1px solid var(--border); }
    .faq-btn {
      width: 100%; background: none; border: none;
      color: var(--text-primary); font-family: var(--font-mono);
      font-size: 1rem; text-align: left; padding: 24px 0;
      cursor: pointer; display: flex; justify-content: space-between; align-items: center;
    }
    .faq-btn:hover { color: var(--accent); }
    .faq-content {
      max-height: 0; overflow: hidden;
      transition: max-height var(--dur-base) var(--ease-spring);
    }
    .faq-content p { padding-bottom: 24px; color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; }

    .cta-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 48px;
      margin-top: 40px;
    }
    .cta-box h2 {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: clamp(2rem, 4vw, 2.5rem);
    }
    .cta-btn {
      display: inline-block; margin-top: 24px; padding: 12px 24px;
      background: transparent; color: var(--accent); border: 1px solid var(--accent);
      text-decoration: none; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em;
      transition: all var(--dur-quick) var(--ease-enter);
    }
    .cta-btn:hover { background: var(--accent); color: var(--bg); }

    .footer { text-align: center; padding: 40px 0; border-top: 1px solid var(--border); margin-top: 80px; }
  </style>

  <main>
    <div id="progress-bar"></div>
    <canvas id="ambient-canvas"></canvas>
    
    <nav class="top-nav">
      <div class="nav-left">
        <span class="prompt">$</span>
        <img loading="lazy" decoding="async" src="https://gauvreaucpa.ca/hs-fs/hubfs/Mobile%20Logo_-1.png" alt="Gauvreau" style="height:14px;width:auto;display:block;">
      </div>
      <div class="nav-right">
        <a href="/" class="nav-link">&larr; Back to Suite</a>
      </div>
    </nav>

    <div class="content-wrapper">
      <section id="hero" class="reveal">
        <div class="badge">[STATUS: LIVE] &middot; Client Intake</div>
        <h1>Client File Intake &mdash; A ShareFile Alternative</h1>
        <p class="section-body" style="font-size: 1.2rem; max-width: 800px;">
          A branded upload page where clients enter their name and email, drop their files, and have them land in your firm's OneDrive &mdash; no login, no account, no Microsoft sign-in for the client.
        </p>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">The Challenge</span>
        <h2 class="section-title reveal">Getting files from clients shouldn't be this hard</h2>
        <p class="section-body reveal">
          Tax slips, statements and signed documents arrive by email attachment, paid file-sharing portals, or not at all.
        </p>

        <div class="card-grid">
          <div class="card reveal">
            <h3>Email attachments</h3>
            <p>Size limits bounce large files, and documents end up scattered across a dozen inboxes.</p>
          </div>
          <div class="card reveal">
            <h3>Client accounts and passwords</h3>
            <p>Portals that make clients sign up and remember a password lose half of them at the login screen.</p>
          </div>
          <div class="card reveal">
            <h3>Per-seat portal fees</h3>
            <p>Dedicated file-sharing services charge every month for something your firm's OneDrive can already store.</p>
          </div>
          <div class="card reveal">
            <h3>Who was it for?</h3>
            <p>Files arrive with no note on who sent them, or which team member or department should pick them up.</p>
          </div>
        </div>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Workflow</span>
        <h2 class="section-title reveal">How it works</h2>

        <div class="flow-steps reveal">
          <div class="flow-step">
            <span class="flow-num">01</span>
            <div>
              <h4>Client opens your link</h4>
              <p>They pick who the files are for &mdash; a department or a named team member &mdash; and enter their name, email and an optional note.</p>
            </div>
          </div>
          <div class="flow-step">
            <span class="flow-num">02</span>
            <div>
              <h4>Drop the files</h4>
              <p>Up to 25 files per submission, uploaded in chunks straight to OneDrive. Large files are no problem.</p>
            </div>
          </div>
          <div class="flow-step">
            <span class="flow-num">03</span>
            <div>
              <h4>Files land in your folder</h4>
              <p>Each submission gets its own dated subfolder, filed under the department or person the client chose.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Capabilities</span>
        <h2 class="section-title reveal">Features</h2>
        <div class="card-grid" style="margin-bottom: 32px;">
          <div class="card reveal"><h3>No client login</h3><p>No account, no password, no Microsoft sign-in. Clients just open the page and upload.</p></div>
          <div class="card reveal"><h3>Your own OneDrive</h3><p>Files go straight into a folder your firm already owns. No third-party storage, no per-seat fees.</p></div>
          <div class="card reveal"><h3>Large files welcome</h3><p>Chunked uploads go directly to OneDrive, up to 2 GB per file by default.</p></div>
          <div class="card reveal"><h3>Route to the right person</h3><p>A searchable picker lists every department and team member, built from your staff directory.</p></div>
          <div class="card reveal"><h3>A record of every submission</h3><p>Each folder holds a summary: who sent it, when, their note, and every file's original name and size.</p></div>
          <div class="card reveal"><h3>Retry what didn't finish</h3><p>On a slow connection, the page reports exactly which files didn't finish and offers to retry them.</p></div>
        </div>

        <h3 class="reveal" style="font-family: var(--font-mono); font-size: 1.1rem; margin-top: 40px; color: var(--accent);">Every submission, filed the same way</h3>
        <p class="section-body reveal">Department or person &rarr; <code>YYYY-MM-DD client-name ticket</code> &rarr; files + submission summary</p>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Safeguards</span>
        <h2 class="section-title reveal">Built for an accounting practice</h2>
        <ul class="check-list reveal">
          <li>Optional access code, so only clients you give it to can upload</li>
          <li>Allowlist of accepted file types &mdash; macro-enabled Office files and executables are refused</li>
          <li>Filenames cleaned on the way in; the client's original name is kept in the record</li>
          <li>Rate limiting and server-side checks on every submission</li>
          <li>Upload links can add files but cannot delete anything</li>
          <li>Security headers that stop the page being framed or tampered with</li>
        </ul>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Comparison</span>
        <h2 class="section-title reveal">Before / After</h2>

        <div class="compare-grid">
          <div class="compare-card before reveal">
            <h3 style="color: var(--error); margin-bottom: 16px;">Email &amp; portals</h3>
            <ul>
              <li>Client emails attachments, some bounce</li>
              <li>Or signs up for a portal and forgets the password</li>
              <li>Files sit in whoever's inbox they reached</li>
              <li>Staff save them to the right folder by hand</li>
              <li>Monthly per-seat portal fees</li>
            </ul>
          </div>
          <div class="compare-card after reveal">
            <h3 style="color: var(--success); margin-bottom: 16px;">Client File Intake</h3>
            <ul>
              <li>Client opens one link, no sign-in</li>
              <li>Picks who the files are for</li>
              <li>Drops files of any practical size</li>
              <li>Files land in OneDrive, already organized</li>
              <li style="color: var(--success);">Stored in storage your firm already owns</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Value</span>
        <h2 class="section-title reveal">Benefits</h2>
        <div class="card-grid">
          <div class="card reveal"><h3>Easier for clients</h3><p>One link, no account. More documents arrive, and they arrive sooner.</p></div>
          <div class="card reveal"><h3>Organized on arrival</h3><p>Every upload is filed by team and date with a summary of who sent what.</p></div>
          <div class="card reveal"><h3>No extra subscription</h3><p>Uses the OneDrive your firm already pays for.</p></div>
          <div class="card reveal"><h3>Your data stays yours</h3><p>Files never pass through a third-party file service &mdash; they go straight to your folder.</p></div>
        </div>
      </section>

      <section class="below-fold">
        <span class="section-eyebrow reveal">Knowledge Base</span>
        <h2 class="section-title reveal">FAQ</h2>

        <div class="faq-container reveal">
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">Do clients need an account? <span>+</span></button>
            <div class="faq-content"><p>No. Clients enter their name and email and upload. There is no login and no Microsoft sign-in.</p></div>
          </div>
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">Where do the files go? <span>+</span></button>
            <div class="faq-content"><p>Into one OneDrive folder your firm chooses. Every submission gets its own dated subfolder, under the department or person the client picked.</p></div>
          </div>
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">How large can files be? <span>+</span></button>
            <div class="faq-content"><p>Up to 25 files per submission and 2 GB per file by default. Both limits can be adjusted.</p></div>
          </div>
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">Can we keep the page private? <span>+</span></button>
            <div class="faq-content"><p>Yes. Set an access code, and only clients you give it to can submit files.</p></div>
          </div>
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">Which file types are accepted? <span>+</span></button>
            <div class="faq-content"><p>Common document, spreadsheet and image types. Macro-enabled Office files, executables and scripts are refused.</p></div>
          </div>
          <div class="faq-item">
            <button class="faq-btn" aria-expanded="false">Will we know when files arrive? <span>+</span></button>
            <div class="faq-content"><p>A simple Power Automate flow on the folder can email your office for each new submission, with the sender's details included.</p></div>
          </div>
        </div>
      </section>

      <section class="below-fold">
        <div class="cta-box reveal">
          <span class="prompt">$</span>
          <h2>One link. Every client file.</h2>
          <p style="margin: 16px 0; color: var(--text-primary); font-size: 1.2rem;">No logins. No portal fees. Straight to your OneDrive.</p>
          <a href="mailto:info@gauvreaucpa.ca" class="cta-btn">Initialize Service</a>
        </div>
      </section>

      <footer class="footer">
        <a href="/" class="nav-link">&larr; Back to Suite</a>
      </footer>
    </div>
  </main>

  <script is:inline>
    // Scroll progress
    const progress = document.getElementById('progress-bar');
    window.addEventListener('scroll', () => {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      if (h > 0) progress.style.width = (window.scrollY / h * 100) + '%';
    }, { passive: true });

    // Intersection Observer for reveals
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-transitioning');
          requestAnimationFrame(() => {
            entry.target.classList.add('is-visible');
          });
          
          entry.target.addEventListener('transitionend', function handler(e) {
            if (e.propertyName === 'transform') {
              entry.target.classList.remove('is-transitioning');
              entry.target.removeEventListener('transitionend', handler);
            }
          });
          
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // FAQ Accordion
    document.querySelectorAll('.faq-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', !expanded);
        btn.querySelector('span').textContent = expanded ? '+' : '−';
        
        const content = btn.nextElementSibling;
        if (!expanded) {
          content.style.maxHeight = content.scrollHeight + 'px';
        } else {
          content.style.maxHeight = '0px';
        }
      });
    });

    // Ambient Canvas
    (() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const canvas = document.getElementById('ambient-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d', { alpha: true });
      const LINE_SPACING = 56;
      let w = 0, h = 0, dpr = 1, offset = 0, scrollVel = 0, lastY = window.scrollY;
      let rafId, isHidden = false;
      
      function resize() {
        dpr = Math.min(devicePixelRatio, 2);
        w = window.innerWidth; h = window.innerHeight;
        canvas.width = w * dpr; canvas.height = h * dpr;
        canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      
      let rTimer;
      window.addEventListener('resize', () => { clearTimeout(rTimer); rTimer = setTimeout(resize, 100); }, { passive: true });
      resize();
      
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        scrollVel = Math.min(Math.abs(y - lastY), 20);
        lastY = y;
        setTimeout(() => { scrollVel = Math.max(0, scrollVel - 2); }, 80);
      }, { passive: true });
      
      function draw() {
        if (isHidden) return;
        ctx.clearRect(0, 0, w, h);
        const speed = 0.3 + scrollVel * 0.004;
        offset = (offset + speed) % LINE_SPACING;
        const count = Math.ceil(h / LINE_SPACING) + 2;
        ctx.beginPath();
        ctx.strokeStyle = 'rgba(212, 168, 67, 0.04)';
        ctx.lineWidth = 1;
        for (let i = 0; i < count; i++) {
          const y = Math.round(i * LINE_SPACING - offset);
          ctx.moveTo(0, y); ctx.lineTo(w, y);
        }
        ctx.stroke();
        rafId = requestAnimationFrame(draw);
      }
      
      document.addEventListener('visibilitychange', () => {
        isHidden = document.hidden;
        if (!isHidden) { offset = 0; draw(); } else cancelAnimationFrame(rafId);
      });
      draw();
    })();
  </script>
</SubpageLayout>
